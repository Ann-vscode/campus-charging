<?xml version="1.0"?>
<!--
  campus.world - Gazebo classic (SDF 1.6) scene for R3.1.
  All coordinates are SIMULATED campus coordinates scaled 1:10.
  Scene (x,y) -> World (x/10, y/10).
  SIMULATION ONLY - no real vehicle / real telemetry data.
  ASCII comments only; no non-ASCII inside XML.
-->
<sdf version="1.6">
  <world name="campus_world">

    <!-- ===== standard includes ===== -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- GUI camera: top-down-ish view covering the 16m x 8m field -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>8 4 12 0 1.5 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ===== ODE physics (structure follows turtlebot3_world.world) ===== -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ===== gray field floor (visual only, 16 x 8 m, centered at 8,4) ===== -->
    <model name="campus_field_floor">
      <static>true</static>
      <pose>8 4 0.005 0 0 0</pose>
      <link name="floor_link">
        <visual name="floor_visual">
          <geometry><box><size>16 8 0.01</size></box></geometry>
          <material>
            <ambient>0.32 0.32 0.32 1</ambient>
            <diffuse>0.32 0.32 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== parking zones (pure visual, flat boxes, height 0.02) ===== -->
    <!-- A: scene x[0,30] y[0,20] -> world x[0,3] y[0,2], 12 spaces, BLUE -->
    <model name="parking_zone_A">
      <static>true</static>
      <pose>1.5 1.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 2 0.02</size></box></geometry>
          <material>
            <ambient>0.0 0.15 0.75 1</ambient>
            <diffuse>0.0 0.15 0.75 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- B: scene x[50,90] -> world x[5,9], 10 spaces, GREEN -->
    <model name="parking_zone_B">
      <static>true</static>
      <pose>7.0 1.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 2 0.02</size></box></geometry>
          <material>
            <ambient>0.0 0.7 0.15 1</ambient>
            <diffuse>0.0 0.7 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- C: scene x[110,140] -> world x[11,14], 8 spaces, ORANGE -->
    <model name="parking_zone_C">
      <static>true</static>
      <pose>12.5 1.0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3 2 0.02</size></box></geometry>
          <material>
            <ambient>1.0 0.45 0.0 1</ambient>
            <diffuse>1.0 0.45 0.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== parking space divider lines (pure visual, white) ===== -->
    <model name="A_div_h"><static>true</static><pose>1.5 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>3 0.015 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="A_div_v1"><static>true</static><pose>0.5 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="A_div_v2"><static>true</static><pose>1.0 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="A_div_v3"><static>true</static><pose>1.5 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="A_div_v4"><static>true</static><pose>2.0 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="A_div_v5"><static>true</static><pose>2.5 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <model name="B_div_h"><static>true</static><pose>7.0 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>4 0.015 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="B_div_v1"><static>true</static><pose>5.8 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="B_div_v2"><static>true</static><pose>6.6 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="B_div_v3"><static>true</static><pose>7.4 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="B_div_v4"><static>true</static><pose>8.2 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <model name="C_div_h"><static>true</static><pose>12.5 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>3 0.015 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="C_div_v1"><static>true</static><pose>11.75 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="C_div_v2"><static>true</static><pose>12.5 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>
    <model name="C_div_v3"><static>true</static><pose>13.25 1.0 0.031 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.015 2 0.002</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- ===== base station pedestal (visual) at scene (70,40) -> world (7.0,4.0) ===== -->
    <model name="base_station_pad">
      <static>true</static>
      <pose>7.0 4.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.02</size></box></geometry>
          <material>
            <ambient>0.1 0.1 0.35 1</ambient>
            <diffuse>0.1 0.1 0.35 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- base station pole (landmark, solid), offset so it does not block spawn -->
    <model name="base_station_pole">
      <static>true</static>
      <pose>7.0 3.25 0.3 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.12 0.12 0.6</size></box></geometry>
          <material><ambient>0.1 0.1 0.4 1</ambient><diffuse>0.1 0.1 0.4 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.12 0.12 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ===== 5 charging piles in one row beside base station ===== -->
    <!-- y=4.5, x=6.0..6.8; distinct colors act as the "ID label" (1..5) -->
    <model name="charging_pile_1">
      <static>true</static><pose>6.0 4.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.12 0.12 0.3</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.12 0.12 0.3</size></box></geometry></collision>
      </link>
    </model>
    <model name="charging_pile_2">
      <static>true</static><pose>6.2 4.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.12 0.12 0.3</size></box></geometry>
          <material><ambient>0.1 0.35 0.9 1</ambient><diffuse>0.1 0.35 0.9 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.12 0.12 0.3</size></box></geometry></collision>
      </link>
    </model>
    <model name="charging_pile_3">
      <static>true</static><pose>6.4 4.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.12 0.12 0.3</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.12 0.12 0.3</size></box></geometry></collision>
      </link>
    </model>
    <model name="charging_pile_4">
      <static>true</static><pose>6.6 4.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.12 0.12 0.3</size></box></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.12 0.12 0.3</size></box></geometry></collision>
      </link>
    </model>
    <model name="charging_pile_5">
      <static>true</static><pose>6.8 4.5 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.12 0.12 0.3</size></box></geometry>
          <material><ambient>0.6 0.2 0.8 1</ambient><diffuse>0.6 0.2 0.8 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.12 0.12 0.3</size></box></geometry></collision>
      </link>
    </model>

    <!-- ===== static obstacles: walls and pillars, leaving a clear corridor ===== -->
    <model name="obstacle_wall_AB">
      <static>true</static><pose>4.3 2.9 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.1 1.8 0.5</size></box></geometry>
          <material><ambient>0.85 0.8 0.25 1</ambient><diffuse>0.85 0.8 0.25 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.1 1.8 0.5</size></box></geometry></collision>
      </link>
    </model>
    <model name="obstacle_wall_BC">
      <static>true</static><pose>10.0 2.9 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.1 1.8 0.5</size></box></geometry>
          <material><ambient>0.85 0.8 0.25 1</ambient><diffuse>0.85 0.8 0.25 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.1 1.8 0.5</size></box></geometry></collision>
      </link>
    </model>
    <model name="obstacle_pillar_1">
      <static>true</static><pose>3.5 6.0 0.3 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.2 0.2 0.6</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.2 0.2 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="obstacle_pillar_2">
      <static>true</static><pose>9.5 6.0 0.3 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.2 0.2 0.6</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.2 0.2 0.6</size></box></geometry></collision>
      </link>
    </model>
    <model name="obstacle_pillar_3">
      <static>true</static><pose>14.5 6.0 0.3 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.2 0.2 0.6</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.2 0.2 0.6</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
